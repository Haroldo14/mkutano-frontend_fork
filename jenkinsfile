pipeline {
    agent any
    environment{
        FILEPATH_SNAPSHOT='/var/jenkins_home/snapshot.txt'
        // HARBOR_REGISTRY = 'http://217.160.24.222/harbor/projects'
             
    }

    parameters{
        choice(name: 'BUILD_TYPE', choices: ['SNAPSHOT', 'RELEASE'], description: 'Choisissez le type de build')
        string(name: 'VERSION', defaultValue: '1.0.0', description: 'La version de la release')
    }

    stages{
        stage("clean workspace"){
            steps{
                cleanWs()
            }
        }

        stage("checkout project"){
            steps{
                script{
                    git branch: env.BRANCH_NAME, url:'https://github.com/Haroldo14/mkutano-frontend_fork.git' , credentialsId:'Github_user'
                }
            }
        }
        stage("build artefact"){
            steps{
                script{
                   if(params.BUILD_TYPE=='RELEASE'){
                    sh "mvn versions:set -DnewVersion=${params.VERSION}"
                   }else{
                    sh "mvn versions:set -DnewVersion=${params.VERSION}-${params.BUILD_TYPE}"
                   }
                   sh 'mvn clean package' //--settings /var/jenkins_home/.m2/settings.xml'
                   sh 'cat /etc/docker/daemon.json'
                }
            }
        }
        stage("Push to Nexus"){
            steps{
                script{
                    echo "Bonjour step 4"
                    sh "mvn clean deploy -P nexus -DskipTests --settings /var/jenkins_home/.m2/settings.xml"

                }
            }
        }
        stage("Build Docker Image") {
            steps {
                script {
                    //def dockerTag = "${IMAGE_NAME}:${params.VERSION}-${params.BUILD_TYPE}".toLowerCase()
                    //sh "docker build -t ${dockerTag} ."
                    dockerImage = docker.build("quarkus-run:${params.VERSION}", ".");
                    //sh "docker scout cves ${dockerTag}"
                }
            }
        }
        
        stage('Login to Harbor') {
            steps {
                script {
                    //docker.withRegistry("https://${HARBOR_REGISTRY}", "${DOCKER_CREDENTIALS_ID}")
                        //echo "Logged into Harbor successfully."
                    withCredentials([usernamePassword(credentialsId: 'Harbor_user', usernameVariable: 'HARBOR_USERNAME', passwordVariable: 'HARBOR_PASSWORD')]) {
                    sh 'docker login -u $HARBOR_USERNAME -p $HARBOR_PASSWORD http://217.160.24.222:80'
                    // Tag the image
                    sh "docker tag quarkus-run:${params.VERSION} 217.160.24.222:80/harbor/projets/mkutano-frontend/quarkus-run:${params.VERSION}"
                    }
                }    
            }   
        }
    }
}
